[
  {
    "label": "Build Solution",
    "command": "dotnet",
    "args": ["build", "GameDevelopment.slnx"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "on_success",
    "save": "all"
  },
  {
    "label": "Run Game",
    "command": "dotnet",
    "args": ["run", "--project", "Game/Game.csproj"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always",
    "hide": "never",
    "save": "all"
  }
]
